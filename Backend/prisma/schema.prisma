generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_MOVED_TO_REVIEW
}

// ============================================================
// USER
// ============================================================

model User {
  id           String @id @default(uuid()) @db.Uuid
  name         String
  email        String @unique
  passwordHash String
  role         Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProjects Project[] @relation("ProjectCreatedBy")
  managedProjects Project[] @relation("ProjectManager")

  assignedTasks Task[] @relation("TaskAssignedDeveloper")

  activities Activity[]

  notifications Notification[]

  refreshTokens RefreshToken[]

  @@index([role])
  @@map("users")
}

// ============================================================
// CLIENT
// ============================================================

model Client {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  company String
  email   String?
  phone   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@index([company])
  @@map("clients")
}

// ============================================================
// PROJECT
// ============================================================

model Project {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?

  clientId  String  @db.Uuid
  createdBy String  @db.Uuid
  managerId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  creator User @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  manager User? @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  tasks Task[]

  activities Activity[]

  @@index([clientId])
  @@index([createdBy])
  @@index([managerId])
  @@map("projects")
}

// ============================================================
// TASK
// ============================================================

model Task {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid

  title       String
  description String?

  assignedDeveloperId String? @db.Uuid

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  dueDate   DateTime?
  isOverdue Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignedDeveloper User? @relation("TaskAssignedDeveloper", fields: [assignedDeveloperId], references: [id], onDelete: SetNull)

  activities Activity[]

  notifications Notification[]

  @@index([projectId])
  @@index([assignedDeveloperId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([isOverdue])
  @@index([status, dueDate])
  @@index([priority, dueDate])
  @@map("tasks")
}

// ============================================================
// ACTIVITY
// ============================================================

model Activity {
  id String @id @default(uuid()) @db.Uuid

  projectId String @db.Uuid
  taskId    String @db.Uuid
  userId    String @db.Uuid

  action   String
  oldValue String?
  newValue String?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("activities")
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String  @db.Uuid
  taskId String? @db.Uuid

  type    NotificationType
  message String

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([taskId])
  @@map("notifications")
}

// ============================================================
// REFRESH TOKEN
// ============================================================

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  tokenHash String @unique

  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}
